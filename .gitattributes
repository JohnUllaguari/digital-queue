# Auto-detect text files and normalize line endings
* text=auto

# Source files always use LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf

# Windows-specific files keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
